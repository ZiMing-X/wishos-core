{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wishos.dev/schemas/node.schema.json",
  "title": "WishOS Graph Node",
  "type": "object",
  "required": [
    "id",
    "type",
    "title",
    "ts",
    "edges"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "enum": [
        "project",
        "event",
        "claim",
        "evidence",
        "inference",
        "conclusion",
        "card",
        "ticket",
        "artifact",
        "session"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "ts": {
      "type": "string"
    },
    "edges": {
      "type": "object",
      "properties": {
        "parent": {
          "type": [
            "string",
            "null"
          ]
        },
        "children": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "chain_prev": {
          "type": [
            "string",
            "null"
          ]
        },
        "chain_next": {
          "type": [
            "string",
            "null"
          ]
        },
        "supports": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "contradicts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "derived_from": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "attached": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
