{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wishos.dev/schemas/node.schema.json",
  "title": "WishOS Graph Node",
  "type": "object",
  "required": [
    "id",
    "type",
    "title",
    "ts",
    "edges"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "enum": [
        "project",
        "event",
        "claim",
        "evidence",
        "inference",
        "conclusion",
        "card",
        "ticket",
        "artifact",
        "session",
        "plan",
        "decision",
        "schedule"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "ts": {
      "type": "string"
    },
    "edges": {
      "type": "object",
      "properties": {
        "parent": {
          "type": [
            "string",
            "null"
          ]
        },
        "children": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "chain_prev": {
          "type": [
            "string",
            "null"
          ]
        },
        "chain_next": {
          "type": [
            "string",
            "null"
          ]
        },
        "supports": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "contradicts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "derived_from": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "attached": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "status": {
      "type": "string",
      "minLength": 1,
      "description": "节点状态（非版本字段，不换 bcode）。取值语义由 gate 校验：active|demoted|historical|retired 及既有 plan 状态。"
    },
    "alias": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "demoted": {
      "type": "object",
      "required": [
        "from_type",
        "from_role",
        "at",
        "reason",
        "decision_id"
      ],
      "properties": {
        "from_type": {
          "type": "string",
          "minLength": 1
        },
        "from_role": {
          "type": "string",
          "minLength": 1
        },
        "from_parent": {
          "type": [
            "string",
            "null"
          ]
        },
        "at": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "decision_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "scope": {
      "type": "object",
      "properties": {
        "epoch": {
          "type": "string",
          "minLength": 1
        },
        "valid_from": {
          "type": "string"
        },
        "valid_until": {
          "type": [
            "string",
            "null"
          ]
        },
        "domain": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "default_entry": {
      "type": [
        "string",
        "null"
      ]
    },
    "status_history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
