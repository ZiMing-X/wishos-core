{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wishos.dev/schemas/ticket.schema.json",
  "title": "WishOS Ticket",
  "type": "object",
  "required": ["id", "wish", "intent", "acceptance", "budget", "risk", "status", "created_at"],
  "properties": {
    "id": { "type": "string", "pattern": "^T-[A-Za-z0-9._-]+$" },
    "wish": { "type": "string", "minLength": 1 },
    "intent": { "type": "string", "minLength": 1 },
    "acceptance": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "context": {
      "type": "object",
      "properties": {
        "cards": { "type": "array", "items": { "type": "string" } },
        "lessons": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "plan": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "task", "acceptance"],
        "properties": {
          "id": { "type": "string" },
          "task": { "type": "string" },
          "acceptance": { "type": "array", "items": { "type": "string" } },
          "depends_on": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": true
      }
    },
    "budget": {
      "type": "object",
      "properties": { "minutes": { "type": "number", "minimum": 0 }, "steps": { "type": "number", "minimum": 0 } },
      "additionalProperties": true
    },
    "risk": {
      "type": "object",
      "properties": { "tier0": { "type": "array", "items": { "type": "string" } } },
      "additionalProperties": true
    },
    "status": { "type": "string", "enum": ["idle", "working", "person", "blocked", "failed", "done"] },
    "created_at": { "type": "string" },
    "closed_at": { "type": "string" },
    "worker": { "type": ["string", "null"] },
    "result": { "type": "string" },
    "result_artifacts": { "type": "array", "items": { "type": "string" } },
    "focus_node": { "type": "string" },
    "route": { "type": "object" },
    "note": { "type": "string" }
  },
  "additionalProperties": true
}
