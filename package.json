  "icon": "icon.svg",
  "license": "Apache-2.0",
  "author": "ZiMing-X",
  "homepage": "https://github.com/ZiMing-X/wishos-core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZiMing-X/wishos-core.git"
  },
  "bugs": {
    "url": "https://github.com/ZiMing-X/wishos-core/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "wishos",
    "agent-preset",
    "skills",
    "second-brain"
  ],
  "engines": {
